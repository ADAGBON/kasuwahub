# Copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kasuwahub
# Separate database for `npm test` — it is wiped on every run
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kasuwahub_test
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Seeded admin account (npm run seed)
ADMIN_EMAIL=admin@kasuwahub.ng
ADMIN_PASSWORD=ChangeMe123!

# Paystack (test mode keys from dashboard.paystack.com → Settings → API Keys)
# Leave blank to use the built-in demo payment flow.
PAYSTACK_SECRET_KEY=

# Cloudinary (optional — for admin image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
